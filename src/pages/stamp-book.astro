---
import BaseLayout from "../layouts/BaseLayout.astro";

const calendarStamps = [
  { image: "/stamps/stamp_calendar_january.png", title: "Fresh January" },
  { image: "/stamps/stamp_calendar_february.png", title: "Fond February" },
  { image: "/stamps/stamp_calendar_march.png", title: "Marching On" },
  { image: "/stamps/stamp_calendar_april.png", title: "April Showers" },
  { image: "/stamps/stamp_calendar_may.png", title: "Merry May" },
  { image: "/stamps/stamp_calendar_june.png", title: "June in Bloom" },
  { image: "/stamps/stamp_calendar_july.png", title: "Golden July" },
  { image: "/stamps/stamp_calendar_august.png", title: "August Glow" },
  { image: "/stamps/stamp_calendar_september.png", title: "Soft September" },
  { image: "/stamps/stamp_calendar_october.png", title: "October Oddities" },
  { image: "/stamps/stamp_calendar_november.png", title: "Cosy November" },
  { image: "/stamps/stamp_calendar_december.png", title: "December Done" },
];

const achievementStamps = [
  {
    image: "/stamps/stamp_milestone_first.png",
    title: "First Sort",
    detail: "Review your first photo.",
    className: "coral",
  },
  {
    image: "/stamps/stamp_milestone_100.png",
    title: "Tidy Hundred",
    detail: "Review 100 photos.",
    className: "sage",
  },
  {
    image: "/stamps/stamp_streak_3.png",
    title: "Three-Day Tidy",
    detail: "Review photos across three consecutive days.",
    className: "blue",
  },
  {
    image: "/stamps/stamp_secret_old_photo.png",
    title: "Long Forgotten",
    detail: "Rediscover a photograph from long ago.",
    className: "gold",
  },
];
---

<BaseLayout
  title='The Stamp Book | Fewer Photos'
  description='Complete months, reach review milestones, build streaks and collect personal location stamps while tidying your camera roll.'
>
  <section class='page-header'>
    <p class='eyebrow'>The Stamp Book</p>
    <h1>A little record of every photo-sorting victory.</h1>

    <p class='introduction'>
      Tidying a camera roll is useful, but it does not need to feel like
      administration. Fewer Photos turns completed months, review milestones and
      rediscovered places into a personal collection of stamps.
    </p>
  </section>

  <section class='stamp-book-preview' aria-labelledby='stamp-preview-heading'>
    <div class='stamp-preview-copy'>
      <p class='eyebrow'>Your collection</p>

      <h2 id='stamp-preview-heading'>
        Every stamp tells part of your library’s story.
      </h2>

      <p>
        Complete months, reach milestones, build little rituals and rediscover
        places already hidden inside your photo library.
      </p>
    </div>

    <div class='stamp-book-phone'>
      <img
        src='/hero-stamp-book.jpeg'
        alt='The Fewer Photos Stamp Book showing monthly stamps, a collected First Sort milestone and Coming Soon stamps.'
      />
    </div>
  </section>

  <section
    class='calendar-showcase'
    aria-labelledby='calendar-showcase-heading'
  >
    <div class='section-heading'>
      <p class='eyebrow'>A year of progress</p>
      <h2 id='calendar-showcase-heading'>
        Complete a month. Add its stamp to your collection.
      </h2>
    </div>

    <div class='calendar-grid'>
      {
        calendarStamps.map((stamp) => (
          <article class='calendar-stamp'>
            <img
              src={stamp.image}
              alt=''
              loading='lazy'
              aria-hidden='true'
            />

            <h3>{stamp.title}</h3>
          </article>
        ))
      }
    </div>
  </section>

  <section class='stamp-types' aria-labelledby='stamp-types-heading'>
    <div class='section-heading'>
      <p class='eyebrow'>More than monthly completion</p>
      <h2 id='stamp-types-heading'>Small goals hidden throughout the app.</h2>
    </div>

    <div class='achievement-grid'>
      {
        achievementStamps.map((stamp) => (
          <article class={stamp.className}>
            <div class='achievement-mark'>
              <img
                src={stamp.image}
                alt=''
                loading='lazy'
                aria-hidden='true'
              />
            </div>

            <div>
              <h3>{stamp.title}</h3>
              <p>{stamp.detail}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class='postmarks'>
    <div class='postmark-copy'>
      <p class='eyebrow'>Personal postmarks</p>
      <h2>Rediscover the places already inside your library.</h2>

      <p>
        Review enough photographs associated with a town and Fewer Photos may
        offer a local postmark. You decide whether the photographs genuinely
        came from your own time there before anything is added.
      </p>

      <p>
        Collect three accepted town stamps from one country to unlock its
        passport stamp.
      </p>
    </div>

    <div
      class='postmark-scene'
      role='img'
      aria-label='A Romania passport stamp surrounded by Iași, Brașov and Bucharest town postmarks.'
    >
      <img
        src='/stamps/stamp_country_romania.png'
        alt=''
        class='location-stamp country-stamp'
        loading='lazy'
        aria-hidden='true'
      />

      <img
        src='/stamps/stamp_town_iasi.png'
        alt=''
        class='location-stamp town-stamp town-one'
        loading='lazy'
        aria-hidden='true'
      />

      <img
        src='/stamps/stamp_town_brasov.png'
        alt=''
        class='location-stamp town-stamp town-two'
        loading='lazy'
        aria-hidden='true'
      />

      <img
        src='/stamps/stamp_town_bucharest.png'
        alt=''
        class='location-stamp town-stamp town-three'
        loading='lazy'
        aria-hidden='true'
      />
    </div>
  </section>

  <section class='privacy-note'>
    <div>
      <p class='eyebrow'>You stay in control</p>
      <h2>Location stamps are always optional.</h2>
    </div>

    <div>
      <p>
        A location can belong to a downloaded image, a shared photograph or
        somebody else's memory. Fewer Photos asks before adding every town
        stamp, and rejecting one does not affect your photo review.
      </p>

      <a href='/privacy'>How location information is handled</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    max-width: 55rem;
    margin-bottom: clamp(4rem, 10vw, 7rem);
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--colour-accent-bright);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 13ch;
    margin-bottom: 1.5rem;
  }

  .introduction {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .passport-preview {
    padding: clamp(1.5rem, 5vw, 3rem);
    border: 1px solid var(--colour-border);
    border-radius: 1.75rem;
    background:
      linear-gradient(135deg, rgba(135, 174, 115, 0.1), transparent 45%),
      var(--colour-surface);
    box-shadow: 0 1.5rem 4rem rgba(44, 54, 42, 0.08);
  }

  .passport-heading {
    margin-bottom: clamp(2rem, 6vw, 4rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .passport-heading h2 {
    max-width: 15ch;
    margin-bottom: 0;
  }

  .collection-count {
    min-width: 7rem;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--colour-border);
    border-radius: 1rem;
    background: var(--colour-background);
    text-align: center;
  }

  .collection-count strong {
    color: var(--colour-coral);
    font-family:
      ui-rounded, "SF Pro Rounded", Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 2rem;
    line-height: 1;
  }

  .collection-count span {
    margin-top: 0.35rem;
    color: var(--colour-text-muted);
    font-size: 0.72rem;
  }

  .calendar-showcase {
    padding-block: clamp(5rem, 11vw, 8rem);
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .calendar-stamp {
    min-width: 0;
    padding: clamp(0.8rem, 2vw, 1.2rem);
    border: 1px solid var(--colour-border);
    border-radius: 1.25rem;
    background: color-mix(
      in srgb,
      var(--colour-surface) 88%,
      transparent
    );
    text-align: center;
  }

  .calendar-stamp img {
    width: 100%;
    height: 13rem;
    display: block;
    object-fit: contain;
    filter: drop-shadow(
      0 0.7rem 0.9rem rgba(35, 42, 34, 0.13)
    );
  }

  .calendar-stamp h3 {
    margin: 0.7rem 0 0;
    color: var(--colour-text);
    font-size: 0.88rem;
    line-height: 1.2;
  }

  .sage {
    color: var(--colour-accent-bright);
    background: rgba(135, 174, 115, 0.08);
  }

  .coral {
    color: var(--colour-coral);
    background: color-mix(in srgb, var(--colour-coral-soft) 55%, transparent);
  }

  .blue {
    color: #6f91aa;
    background: rgba(111, 145, 170, 0.08);
  }

  .gold {
    color: #b58a3f;
    background: rgba(181, 138, 63, 0.08);
  }

  .stamp-types {
    padding-block: clamp(6rem, 13vw, 10rem);
  }

  .section-heading {
    max-width: 48rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .section-heading h2 {
    max-width: 15ch;
  }

  .achievement-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .achievement-grid article {
    min-height: 11rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.5rem;
    border: 1px solid currentColor;
    border-radius: 1.3rem;
  }

  .achievement-mark {
    width: 7rem;
    height: 7rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .achievement-mark img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 0.7rem 0.8rem rgba(35, 42, 34, 0.14));
  }

  .achievement-grid h3 {
    margin-bottom: 0.55rem;
    color: var(--colour-text);
  }

  .achievement-grid p {
    margin-bottom: 0;
    font-size: 0.9rem;
  }

  .achievement-grid .locked {
    color: var(--colour-text-muted);
    background: var(--colour-surface);
    opacity: 0.7;
  }

  .postmarks {
    padding: clamp(2rem, 6vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(20rem, 1fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
    border: 1px solid var(--colour-border);
    border-radius: 1.6rem;
    background:
      radial-gradient(
        circle at 90% 15%,
        rgba(217, 130, 130, 0.17),
        transparent 22rem
      ),
      var(--colour-surface);
  }

  .postmark-copy h2 {
    max-width: 13ch;
    margin-bottom: 1.3rem;
  }

  .postmark-copy p:last-child {
    margin-bottom: 0;
  }

  .postmark-scene {
    min-height: 31rem;
    position: relative;
    isolation: isolate;
  }

  .location-stamp {
    position: absolute;
    display: block;
    object-fit: contain;
    filter: drop-shadow(
      0 1rem 1.25rem rgba(40, 47, 39, 0.18)
    );
  }

  .country-stamp {
    width: min(72%, 20rem);
    height: 25rem;
    top: 2rem;
    left: 50%;
    z-index: 1;
    transform: translateX(-50%) rotate(2deg);
  }

  .town-stamp {
    width: 9.5rem;
    height: 9.5rem;
    z-index: 2;
  }

  .town-one {
    top: 0;
    right: -0.5rem;
    transform: rotate(9deg);
  }

  .town-two {
    right: 0.5rem;
    bottom: 0;
    transform: rotate(-7deg);
  }

  .town-three {
    bottom: 1rem;
    left: 0;
    transform: rotate(6deg);
  }

  .privacy-note {
    margin-top: clamp(6rem, 13vw, 10rem);
    padding: clamp(2rem, 6vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(18rem, 1fr);
    gap: clamp(2rem, 7vw, 6rem);
    border: 1px solid var(--colour-border);
    border-radius: 1.5rem;
    background: var(--colour-surface);
  }

  .privacy-note h2 {
    max-width: 12ch;
    margin-bottom: 0;
  }

  .privacy-note p {
    margin-bottom: 1.2rem;
  }

  .privacy-note a {
    color: var(--colour-accent-bright);
    font-weight: 750;
  }

  .privacy-note a:hover {
    text-decoration: underline;
  }

  @media (max-width: 56rem) {
    .calendar-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .postmarks {
      grid-template-columns: 1fr;
    }

    .postmark-scene {
      width: min(100%, 29rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 42rem) {
    .passport-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .calendar-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .achievement-grid,
    .privacy-note {
      grid-template-columns: 1fr;
    }

    .achievement-grid article {
      min-height: auto;
    }

    .country-stamp {
      width: 70%;
      height: 23rem;
    }

    .town-stamp {
      width: 7.5rem;
      height: 7.5rem;
    }
  }

  @media (max-width: 25rem) {
    .calendar-grid {
      grid-template-columns: 1fr;
    }

    .achievement-grid article {
      grid-template-columns: 1fr;
    }
  }
</style>
