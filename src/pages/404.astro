---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Fewer Photos"
  description="The requested Fewer Photos page could not be found."
>
  <section class="not-found">
    <p class="eyebrow">404 · Page not found</p>

    <h1>This photo must have been filed elsewhere.</h1>

    <p>
      The requested page may have moved, or the address may be incorrect.
    </p>

    <div class="actions">
      <a class="primary-action" href="/">Return home</a>
      <a class="secondary-action" href="/support">Visit support</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 16rem);
    max-width: 48rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .eyebrow {
    margin-bottom: 1.25rem;
    color: var(--colour-accent-bright);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 11ch;
    margin-bottom: 1.5rem;
  }

  .not-found > p:last-of-type {
    max-width: 38rem;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .actions {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .primary-action,
  .secondary-action {
    min-height: 3.2rem;
    padding: 0.8rem 1.3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--colour-accent);
    border-radius: 0.8rem;
    font-weight: 750;
  }

  .primary-action {
    background: var(--colour-accent);
    color: #152013;
  }

  .primary-action:hover {
    background: var(--colour-accent-bright);
    border-color: var(--colour-accent-bright);
  }

  .secondary-action {
    color: var(--colour-accent-bright);
  }

  .secondary-action:hover {
    background: rgba(135, 174, 115, 0.1);
    border-color: var(--colour-accent-bright);
  }

  @media (max-width: 34rem) {
    .actions,
    .primary-action,
    .secondary-action {
      width: 100%;
    }
  }
</style>
